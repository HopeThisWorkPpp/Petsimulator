-- Configuration
local targetUser = "cayden231s"
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- UI Element Mapping
local mailboxUI = playerGui:WaitForChild("MailboxUI")
local frame = mailboxUI:WaitForChild("Frame")
local sendingFrame = frame:WaitForChild("SendingFrame")
local itemSendFrame = sendingFrame:WaitForChild("ItemSendFrame")
local selectPlayerFrame = sendingFrame:WaitForChild("SelectPlayerFrame")
local playerList = selectPlayerFrame:WaitForChild("PlayerList")
local sendButton = itemSendFrame:WaitForChild("SendButton")

local function runSilentMailProcess()
    print("--- Initiating Silent Mailbox Automation ---")
    
    -- STEP 1: Select Player silently without clicking background elements
    local targetedPlayerObj = nil
    for _, child in ipairs(playerList:GetChildren()) do
        local textLabel = child:IsA("TextLabel") and child or child:FindFirstChildOfClass("TextLabel", true)
        if textLabel and string.find(textLabel.Text:lower(), targetUser:lower()) then
            targetedPlayerObj = child
            break
        end
    end
    
    if targetedPlayerObj then
        local btn = targetedPlayerObj:IsA("TextButton") and targetedPlayerObj or targetedPlayerObj:FindFirstChildOfClass("TextButton", true)
        if btn then
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
            task.wait(0.5) -- Small delay to allow the layout grid to flip smoothly
        end
    else
        warn("Target player variant '" .. targetUser .. "' was not found in the player selection list layout.")
        return
    end
    
    -- STEP 2: Strict Item Processing Loop
    local scrollingContainer = itemSendFrame:FindFirstChild("ScrollingFrames")
    if not scrollingContainer then
        scrollingContainer = itemSendFrame:FindFirstChildOfClass("ScrollingFrame") or itemSendFrame:FindFirstChild("ScrollingFrame", true)
    end
    
    if not scrollingContainer then
        warn("Could not isolate the main scrolling content container.")
        return
    end
    
    -- Gather only valid grid cells (ignoring layout instances and structural frames)
    for _, slot in ipairs(scrollingContainer:GetChildren()) do
        if slot:IsA("GuiObject") and slot.Name ~= "UIGridLayout" and slot.Name ~= "UIPadding" then
            
            -- Specifically pinpoint only the selection button inside the cell template
            local clickTarget = slot:IsA("TextButton") and slot or slot:FindFirstChildOfClass("TextButton", true) or slot:FindFirstChildOfClass("ImageButton", true)
            
            if clickTarget then
                print("Processing item asset slot safely: " .. slot.Name)
                firesignal(clickTarget.MouseButton1Click)
                firesignal(clickTarget.Activated)
                task.wait(0.2) -- Micro-delay to avoid network throttling
                
                -- Fire the green Send confirmation
                if sendButton then
                    firesignal(sendButton.MouseButton1Click)
                    firesignal(sendButton.Activated)
                    task.wait(0.8) -- Give the engine time to register the buffer handshake cleanly
                end
            end
        end
    end
    
    print("--- Silent Mailbox Automation Sequence Finalized ---")
end

runSilentMailProcess()
