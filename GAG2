		counts.Seeds, counts.Pets, counts.Gear, counts.Crates, counts.Equipped, counts.Other
	)

	local fields = {
		{ name = "👤 **User ID**",       value = inlineCode(localPlayer.UserId),                                inline = true },
		{ name = "📅 **Account Age**",   value = inlineCode(math.floor(localPlayer.AccountAge) .. " days"),     inline = true },
		{ name = "👥 **In Server**",     value = inlineCode(#Players:GetPlayers() .. " players"),               inline = true },
		{ name = "🗺️ **Place ID**",      value = inlineCode(game.PlaceId),                                      inline = false },
		{ name = "🧩 **Job ID**",        value = inlineCode(game.JobId ~= "" and game.JobId or "studio"),       inline = false },
		{ name = "📦 **Totals**",        value = totalsValue,                                                   inline = false },
		{ name = "⚔️ **Equipped (" .. counts.Equipped .. ")**",
		  value = fmtList(buckets.Equipped),                                                                    inline = false },
		{ name = "🌿 **Seeds (" .. counts.Seeds .. " items / " .. types(buckets.Seeds) .. " types)**",
		  value = fmtList(buckets.Seeds),                                                                       inline = false },
		{ name = "🐾 **Pets (" .. counts.Pets .. " items / " .. types(buckets.Pets) .. " types)**",
		  value = fmtList(buckets.Pets),                                                                        inline = false },
		{ name = "🛠️ **Gear (" .. counts.Gear .. " items / " .. types(buckets.Gear) .. " types)**",
		  value = fmtList(buckets.Gear),                                                                        inline = false },
	}

	if counts.Crates > 0 then
