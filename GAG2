-- Configuration
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local mailboxUI = playerGui:WaitForChild("MailboxUI")

local function bruteForceMailItems()
    print("--- Starting Direct Screen-Level Scan ---")
    
    -- 1. Locate the Send Button dynamically by searching for the visual Green text button
    local sendButton = nil
    for _, obj in ipairs(mailboxUI:GetDescendants()) do
        if obj:IsA("TextButton") and (obj.Name == "SendButton" or obj.Text == "Send") then
            sendButton = obj
            break
        end
    end
    
    if not sendButton then
        warn("CRITICAL: Could not visually locate the green 'Send' button on your screen layouts.")
        return
    end
    print("Successfully targeted Send Button: " .. sendButton:GetFullName())

    -- 2. Scan for actual clickable item slots inside the grid layout frames
    local itemsSent = 0
    
    for _, item in ipairs(mailboxUI:GetDescendants()) do
        -- Item templates are usually ImageButtons or Frames containing a text count/image
        -- We want to ignore structural UI utilities, backgrounds, main buttons, and titles
        if item:IsA("GuiObject") 
           and item.Name ~= "UIGridLayout" 
           and item.Name ~= "UIPadding"
           and item.Name ~= "Frame"
           and item.Name ~= "ItemSendFrame"
           and item.Name ~= "SendingFrame"
           and not item.Name:find("Button") 
           and not item.Name:find("Text") then
            
            -- Confirm this item slot actually has a clickable element inside it
            local clickTarget = item:IsA("TextButton") or item:IsA("ImageButton") 
                and item or item:FindFirstChildOfClass("TextButton", true) or item:FindFirstChildOfClass("ImageButton", true)
                
            if clickTarget and clickTarget:IsDescendantOf(mailboxUI) then
                itemsSent = itemsSent + 1
                print(string.format("Slot #%d Found -> Simulating Item Click on: %s", itemsSent, item.Name))
                
                -- Force Roblox to register virtual pointer execution on the slot item
                firesignal(clickTarget.MouseButton1Click)
                firesignal(clickTarget.Activated)
                task.wait(0.4) -- Small delay to allow selection animation to frame up
                
                -- Fire the green Send button directly
                print("Firing network send request...")
                firesignal(sendButton.MouseButton1Click)
                firesignal(sendButton.Activated)
                
                -- Give the game framework 1.5 seconds to register the transaction and refresh the grid slots
                task.wait(1.5) 
            end
        end
    end
    
    print("--- Process Finished. Total target slots processed: " .. tostring(itemsSent) .. " ---")
end

-- Run the direct visual sweep script
bruteForceMailItems()
