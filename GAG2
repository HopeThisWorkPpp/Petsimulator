local VirtualInputManager = game:GetService("VirtualInputManager")
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Configuration
local targetUser = "cayden231s"

-- Main Paths
local mailboxUI = playerGui:WaitForChild("MailboxUI")
local frame = mailboxUI:WaitForChild("Frame")
local sendingFrame = frame:WaitForChild("SendingFrame")
local itemSendFrame = sendingFrame:WaitForChild("ItemSendFrame")
local selectPlayerFrame = sendingFrame:WaitForChild("SelectPlayerFrame")
local playerList = selectPlayerFrame:WaitForChild("PlayerList")
local sendButton = itemSendFrame:WaitForChild("SendButton")

-- Helper function to simulate a physical mouse click on an element's center coordinate
local function physicalClick(guiObject)
    if not guiObject or not guiObject.AbsolutePosition then return end
    
    -- Calculate center coordinates of the UI element
    local x = guiObject.AbsolutePosition.X + (guiObject.AbsoluteSize.X / 2)
    local y = guiObject.AbsolutePosition.Y + (guiObject.AbsoluteSize.Y / 2) + 36 -- 36px offset for Roblox topbar
    
    -- Simulate physical mouse down and up
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
    task.wait(0.1)
    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    task.wait(0.2)
end

local function runSequence()
    print("--- Starting Physical Click Sequence ---")
    
    -- 1. Look for the player button in the list and click it
    local playerButton = nil
    for _, child in ipairs(playerList:GetChildren()) do
        local textLabel = child:IsA("TextLabel") and child or child:FindFirstChildOfClass("TextLabel", true)
        if textLabel and string.find(textLabel.Text:lower(), targetUser:lower()) then
            playerButton = child
            break
        end
    end
    
    if playerButton then
        print("Clicking target player button physically...")
        physicalClick(playerButton)
    else
        warn("Target player not found in the PlayerList. Make sure they show up on screen!")
        return
    end
    
    -- 2. Find the scrolling box where the inventory slots live
    local itemContainer = itemSendFrame:FindFirstChild("ScrollingFrames") or itemSendFrame:FindFirstChildOfClass("ScrollingFrame", true)
    if not itemContainer then
        warn("Could not find the scrolling frame holding items.")
        return
    end
    
    -- 3. Loop through and physically click each valid item slot to add it to the mail
    for _, slot in ipairs(itemContainer:GetChildren()) do
        if slot:IsA("GuiObject") and slot.Name ~= "UIGridLayout" and slot.Name ~= "UIPadding" then
            print("Physically clicking item slot: " .. slot.Name)
            physicalClick(slot)
            task.wait(0.2)
        end
    end
    
    -- 4. Finally, physically click the Send Button
    if sendButton then
        print("Physically clicking the Send button...")
        physicalClick(sendButton)
    else
        warn("SendButton path not found.")
    end
    
    print("--- Sequence Complete ---")
end

-- Make sure you have the mailbox menu completely open on your screen before executing this!
runSequence()
