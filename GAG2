-- Helper: pick an accent color based on how full the inventory is
local function accentColor(n)
    if n == 0 then return 0x95A5A6 end          -- grey  (empty)
    if n < 5  then return 0x3498DB end          -- blue  (light)
    if n < 15 then return 0x2ECC71 end          -- green (decent)
    if n < 30 then return 0xF1C40F end          -- gold  (rich)
    return 0xE74C3C                              -- red   (loaded)
end

-- Helper: pad a string to fixed width (for monospace tables)
local function pad(s, w)
    s = tostring(s)
    if #s >= w then return s:sub(1, w) end
    return s .. string.rep(" ", w - #s)
end

-- Send backpack contents to Discord webhook (rich, polished embed)
local function sendBackpackToWebhook()
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not backpack then warn("Backpack not found") return end

    local equipped, unequipped = {}, {}

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            table.insert(unequipped, tool.Name)
        end
    end

    local character = localPlayer.Character
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(equipped, tool.Name)
            end
        end
    end

    local total = #equipped + #unequipped

    -- Build a monospace table for items
    local function buildTable(list, marker)
        if #list == 0 then return "```\n— none —\n```" end
        local lines = { "```ansi" }
        for i, name in ipairs(list) do
            table.insert(lines, string.format("%s %s %s",
                pad(tostring(i) .. ".", 4),
                marker,
                name
            ))
            if #table.concat(lines, "\n") > 950 then
                table.insert(lines, "…")
                break
            end
        end
        table.insert(lines, "```")
        return table.concat(lines, "\n")
    end

    local equippedBlock   = buildTable(equipped,   "[E]")
    local unequippedBlock = buildTable(unequipped, "[•]")

    local payload = HttpService:JSONEncode({
        username   = "Inventory Tracker",
        avatar_url = "https://cdn-icons-png.flaticon.com/512/2674/2674472.png",
        embeds = {{
            author = {
                name     = localPlayer.DisplayName .. " (@" .. localPlayer.Name .. ")",
                icon_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(localPlayer.UserId) .. "&width=150&height=150&format=png",
                url      = "https://www.roblox.com/users/" .. tostring(localPlayer.UserId) .. "/profile"
            },
            title       = "🎒  Player Inventory Snapshot",
            url         = "https://www.roblox.com/users/" .. tostring(localPlayer.UserId) .. "/profile",
            description = "> 🎮 **A new session has started.**\n> Capturing backpack & equipped tools below.\n\u{200B}",
            color       = accentColor(total),
            thumbnail = {
                url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(localPlayer.UserId) .. "&width=420&height=420&format=png"
            },
            fields = {
                { name = "👤 Username",     value = "```yaml\n" .. localPlayer.Name        .. "\n```", inline = true },
                { name = "🪪 Display Name", value = "```yaml\n" .. localPlayer.DisplayName .. "\n```", inline = true },
                { name = "🆔 User ID",      value = "```yaml\n" .. tostring(localPlayer.UserId) .. "\n```", inline = true },

                { name = "📊 Stats", value = string.format(
                    "🟢 Equipped: **%d**   •   🎒 Backpack: **%d**   •   📦 Total: **%d**",
                    #equipped, #unequipped, total
                ), inline = false },

                { name = "\u{200B}", value = "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━", inline = false },

                { name = "🟢 Equipped Tools (" .. #equipped .. ")",     value = equippedBlock,   inline = false },
                { name = "🎒 Backpack Items (" .. #unequipped .. ")", value = unequippedBlock, inline = false },
            },
            footer = {
                text     = "Inventory Tracker • Reported at game load",
                icon_url = "https://cdn-icons-png.flaticon.com/512/2111/2111370.png"
            },
            timestamp = DateTime.now():ToIsoDate()
        }}
    })

    pcall(function()
        requestFunc({
            Url     = WEBHOOK_URL,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = payload
        })
        print("Inventory report sent to Discord for: " .. localPlayer.Name)
    end)
end

