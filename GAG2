-- Main execution sequence manager
task.spawn(function()
	local attempt = 0
	local allDone = false

	while not allDone do
		attempt += 1
		local ok, result = pcall(function()
			return runScript()
		end)

		if not ok then
			task.wait(0.5)
		elseif result == "done" then
			allDone = true
		elseif result == true then
			task.wait(0.5)
		else
			task.wait(0.5)
		end
	end
end)

