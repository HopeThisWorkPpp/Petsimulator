local function safeClick(button)
    if not button then return end
    pcall(function() firesignal(button.Activated) end)
    pcall(function() firesignal(button.MouseButton1Click) end)

    if getconnections then
        for _, connection in pairs(getconnections(button.Activated)) do
            pcall(function() connection:Fire() end)
        end
        for _, connection in pairs(getconnections(button.MouseButton1Click)) do
            pcall(function() connection:Fire() end)
        end
    end
end

local function findNextUnequipButton()
    if not scrollingFrame then return nil end
    for _, desc in pairs(scrollingFrame:GetDescendants()) do
        if (desc:IsA("TextButton") or desc:IsA("ImageButton")) and desc.Name == "Unequip" then
            if not string.find(desc:GetFullName(), "Template") and desc.Visible == true then
                return desc
            end
        end
    end
    return nil
end

