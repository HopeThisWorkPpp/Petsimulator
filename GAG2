local PET_EMOJI = {
    bunny = "🐰",
    robin = "🐦",
    frog  = "🐸",
    deer  = "🦌"
}

local alreadyLogged = {}
local function logTargetPets(inventoryFrame)
    local foundFields = {}
    local totalPets = 0
    for _, child in ipairs(inventoryFrame:GetChildren()) do
        local name = child.Name
        if name:sub(1, 9) == "Inv_Pets:" then
            local petPart = name:sub(10):lower()
            for _, target in ipairs(TARGET_PETS) do
                if petPart:find(target, 1, true) and not alreadyLogged[name] then
                    alreadyLogged[name] = true

                    local count = "?"
                    local innerFrame = child:FindFirstChildWhichIsA("Frame")
                    local countLabel = child:FindFirstChild("Count", true)
                        or child:FindFirstChild("Amount", true)
                        or (innerFrame and innerFrame:FindFirstChildWhichIsA("TextLabel"))
                    if countLabel and countLabel.Text then
                        local n = countLabel.Text:match("%d+")
                        if n then count = n end
                    end

                    local emoji = PET_EMOJI[target] or "🐾"
                    totalPets += (tonumber(count) or 1)

                    table.insert(foundFields, {
                        name = emoji .. " " .. target:sub(1,1):upper() .. target:sub(2),
                        value = "```yaml\nname: " .. name .. "\ncount: " .. tostring(count) .. "\n```",
                        inline = true
                    })

                    print("[PET LOG] " .. emoji .. " Found: " .. name .. " (x" .. tostring(count) .. ")")
                end
            end
        end
    end

    if #foundFields > 0 then
        while (#foundFields % 3) ~= 0 do
            table.insert(foundFields, { name = "\u{200B}", value = "\u{200B}", inline = true })
        end

        table.insert(foundFields, 1, {
            name = "📊 Summary",
            value = string.format("Detected **%d** target pet entries • total stack: **%d**\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
                #foundFields, totalPets),
            inline = false
        })

        sendEmbed(
            "🐾 Target Pets Detected",
            "```ansi\n\27[2;33mLogged Inv_Pets entries matching watchlist: bunny, robin, frog, deer\27[0m\n```",
            0x2ECC71,
            foundFields
        )
    end
end

