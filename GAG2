-- Configuration
local targetUser = "cayden231s" -- The user you want to send items to
local player = game.Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Direct Layout Paths
local mailboxUI = playerGui:WaitForChild("MailboxUI")
local frame = mailboxUI:WaitForChild("Frame")
local sendingFrame = frame:WaitForChild("SendingFrame")

local itemSendFrame = sendingFrame:WaitForChild("ItemSendFrame")
local selectPlayerFrame = sendingFrame:WaitForChild("SelectPlayerFrame")
local sendButton = itemSendFrame:WaitForChild("SendButton")
local playerList = selectPlayerFrame:WaitForChild("PlayerList")

local function autoMailAll()
    print("--- Starting Mailbox Automation ---")
    
    -- STEP 1: Select the player (Only if the selection menu is visible)
    if selectPlayerFrame.Visible or playerList:FindFirstChildOfClass("GuiObject") then
        print("Looking for player: " .. targetUser)
        local targetPlayerButton = nil
        
        for _, child in ipairs(playerList:GetChildren()) do
            -- Look inside the template buttons for the @username text label
            local labels = child:GetDescendants()
            for _, label in ipairs(labels) do
                if label:IsA("TextLabel") and string.find(label.Text:lower(), targetUser:lower()) then
                    targetPlayerButton = child
                    break
                end
            end
            if targetPlayerButton then break end
        end
        
        if targetPlayerButton then
            print("Found player slot! Clicking to switch to Inventory view...")
            local clickTarget = targetPlayerButton:IsA("TextButton") and targetPlayerButton or targetPlayerButton:FindFirstChildOfClass("TextButton", true)
            if clickTarget then
                firesignal(clickTarget.MouseButton1Click)
                firesignal(clickTarget.Activated)
                task.wait(1.0) -- Wait for the UI to flip to the item view
            end
        else
            warn("Could not find '" .. targetUser .. "' in your player selection list.")
            return
        end
    end

    -- STEP 2: Process the inventory items
    local scrollingContainer = itemSendFrame:FindFirstChild("ScrollingFrames")
    if not scrollingContainer then
        scrollingContainer = itemSendFrame:FindFirstChildOfClass("ScrollingFrame") or itemSendFrame:FindFirstChild("ScrollingFrame", true)
    end
    
    if scrollingContainer then
        print("Inventory window detected. Scanning items...")
        
        -- Loop through the item templates
        for _, slot in ipairs(scrollingContainer:GetChildren()) do
            -- Only click valid item containers, ignore padding/grid layouts
            if slot:IsA("GuiObject") and slot.Name ~= "UIGridLayout" and slot.Name ~= "UIPadding" then
                print("Mailing item slot: " .. slot.Name)
                
                -- Click the item grid icon to select it
                local itemClick = slot:IsA("TextButton") and slot or slot:FindFirstChildOfClass("TextButton", true)
                if itemClick then
                    firesignal(itemClick.MouseButton1Click)
                    firesignal(itemClick.Activated)
                    task.wait(0.3)
                end
                
                -- Click the green Send button
                if sendButton then
                    print("Clicking Send...")
                    firesignal(sendButton.MouseButton1Click)
                    firesignal(sendButton.Activated)
                    
                    -- Wait for the packet to register and the item grid to clear/update
                    task.wait(1.2) 
                else
                    warn("Send button path is missing.")
                    break
                end
            end
        end
    else
        warn("Inventory container could not be found. Make sure the inventory grid is on screen.")
    end
    
    print("--- Mailbox Automation Complete ---")
end

-- Run the automation sequence
autoMailAll()
