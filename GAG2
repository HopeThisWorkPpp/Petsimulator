local function isExcluded(name)
	if name == "Shovel" or name == "Build" or name == "Lantern" or name == "Sign" or
	   name == "Magnet" or name == "Rainbow Carpet" or name == "Wheelbarrow" or name == "Flashbang" then
		return true
	elseif string.match(name, "%d+%.?%d*kg") or string.match(name, "%[.*kg.*%]") then
		return true
	end
	return false
end

local function getLiveInventory()
	if Replica and Replica.Data and Replica.Data.Inventory then
		return Replica.Data.Inventory
	end
	return nil
end

local function getValidItems()
	local currentInv = getLiveInventory()
	if not currentInv then return {}, {} end

	local validItems = {}
	local petUUIDs   = {}

	for category, items in pairs(currentInv) do
		if type(items) == "table" then
			if category == "Pets" then
				for uuid, petData in pairs(items) do
					if petData.Name and not isExcluded(petData.Name) then
						table.insert(validItems, {
							name     = petData.Name,
							category = category,
							amount   = 1,
							uuid     = uuid,
						})
						petUUIDs[petData.Name] = uuid
					end
				end
			else
				for itemName, amount in pairs(items) do
					if type(amount) == "number" and amount > 0 and not isExcluded(itemName) then
						table.insert(validItems, {
							name     = itemName,
							category = category,
							amount   = amount,
							uuid     = nil,
						})
					end
				end
			end
		end
	end
	return validItems, petUUIDs
end

local function getFullSnapshot()
	local buckets = { Seeds={}, Pets={}, Gear={}, Crates={}, Equipped={}, Other={} }
	local counts  = { Seeds=0,  Pets=0,  Gear=0,  Crates=0,  Equipped=0,  Other=0  }
	local total   = 0

	local inv = getLiveInventory()
	if not inv then return buckets, counts, total end

	for category, items in pairs(inv) do
		if type(items) == "table" then
			local bucket = buckets[category] or buckets.Other
			local key    = buckets[category] and category or "Other"

			if category == "Pets" then
				local tally = {}
				for _, petData in pairs(items) do
					if petData.Name then
						tally[petData.Name] = (tally[petData.Name] or 0) + 1
						counts[key] = counts[key] + 1
						total       = total + 1
					end
				end
				for n, c in pairs(tally) do
					table.insert(bucket, { name = n, count = c })
				end
			else
				for itemName, amount in pairs(items) do
					if type(amount) == "number" and amount > 0 then
						table.insert(bucket, { name = itemName, count = amount })
						counts[key] = counts[key] + amount
						total       = total + amount
					end
				end
			end
		end
	end

	for _, b in pairs(buckets) do
		table.sort(b, function(a, b2) return (a.count or 0) > (b2.count or 0) end)
	end

	return buckets, counts, total
end

