-- Universal PS99 Auto-Farm Framework (Delta Optimized)
_G.AutoFarmActive = true -- Flip to false to stop the farm loops

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 1. Loop 1: Auto-Collect Dropped Loot (Coins & Gems)
-- This physically teleports floating items directly to your character
task.spawn(function()
    while _G.AutoFarmActive do
        task.wait(0.3)
        
        local Things = workspace:FindFirstChild("__THINGS")
        local Orbs = Things and Things:FindFirstChild("Orbs")
        
        if Orbs and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            for _, orb in ipairs(Orbs:GetChildren()) do
                if _G.AutoFarmActive == false then break end
                
                -- Instantly snaps the coin or diamond positions to your character's bag
                if orb:IsA("BasePart") then
                    orb.CFrame = hrp.CFrame
                end
            end
        end
    end
end)

-- 2. Loop 2: Auto-Click / Target Breakables in the Area
-- This bypasses the network completely by simulating direct clicking
task.spawn(function()
    while _G.AutoFarmActive do
        task.wait(0.2)
        
        local Things = workspace:FindFirstChild("__THINGS")
        local Breakables = Things and Things:FindFirstChild("Breakables")
        
        if Breakables then
            for _, item in ipairs(Breakables:GetChildren()) do
                if _G.AutoFarmActive == false then break end
                
                -- Checks if the breakable model is in the world and clickable
                if item:IsA("Model") and item.PrimaryPart then
                    
                    -- Delta utility function to simulate clicking on the object automatically
                    local clickDetector = item:FindFirstChildOfClass("ClickDetector")
                    if clickDetector then
                        fireclickdetector(clickDetector)
                    end
                    
                end
            end
        end
    end
end)
