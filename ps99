local function getRAP(cat, item)
    local proxy = {
        Class = {Name = cat},
        IsA = function(c) return c == cat end,
        GetId = function() return item.id end,
        StackKey = function()
            return HttpService:JSONEncode({id = item.id, pt = item.pt, sh = item.sh, tn = item.tn})
        end,
        AbstractGetRAP = function() return nil end,
    }
    return require(RS.Library.Client.RAPCmds).Get(proxy) or 0
end

